<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mauiApp1="clr-namespace:MauiApp1"
             x:DataType="mauiApp1:MyViewModel"
             x:Class="MauiApp1.MainPage">

    <VerticalStackLayout Padding="20" Spacing="12">
        <Button Text="Загрузить" Clicked="OnChildMeasureInvalidated" />
        <Button Text="+" Command = "{Binding PlusCommand}"/>
        <Button Text="-" Command="{Binding MinusCommand}"/>
        
        <Label Text="{Binding IntegerForPodsoch}" Margin="11" Padding="11"/>
        
        <!-- Вставь сюда один из вариантов списка выше -->
        
        <CollectionView ItemsSource="{Binding Spacesq}"
                        Margin="0,10,0,0">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="{x:Type x:String}">
                    <Frame Padding="10"
                           Margin="5"
                           CornerRadius="8"
                           HasShadow="False">
                        <Label Text="{Binding .}"
                               FontSize="16" />
                    </Frame>
                </DataTemplate>
                    
            </CollectionView.ItemTemplate>
        </CollectionView>
        
    </VerticalStackLayout>
            
    
</ContentPage>